// Leia a largura e a altura de um retângulo e calcule sua área.
programa {
  funcao inicio() {
    real larguraRetangulo, alturaRetangulo, areaRetangulo
    escreva("Digite a largura: ")
    leia(larguraRetangulo)
    escreva("Digite a altura: ")
    leia(alturaRetangulo)
    areaRetangulo = larguraRetangulo * alturaRetangulo
    escreva("A area do retangulo é: " , areaRetangulo)
  }
}
